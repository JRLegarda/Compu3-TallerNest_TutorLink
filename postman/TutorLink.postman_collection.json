                ],
                "type": "text/javascript"
              }
            }
          ],
          "id": "booking-create",
          "name": "Crear reserva (student)",
          "request": {
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"tutorProfileId\": \"{{tutorProfileId}}\",\n  \"subjectId\": \"{{subjectId}}\",\n  \"startAt\": \"2026-10-20T14:00:00.000Z\",\n  \"endAt\": \"2026-10-20T15:00:00.000Z\"\n}"
            },
            "description": "Solo rol `student` (hagan login como estudiante antes). El tutor debe dictar la materia y no tener otra reserva activa que se cruce (`409`). Las fechas deben ser futuras y `endAt` posterior a `startAt`. El script guarda el `id` en `{{bookingId}}`.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ],
              "raw": "{{baseUrl}}/booking"
            }
          },
          "response": []
        },
        {
          "id": "booking-mine",
          "name": "Ver mis reservas",
          "request": {
            "description": "Requiere sesión. Devuelve reservas donde soy el estudiante o el tutor. Filtro opcional `status` y paginación.",
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "mine"
              ],
              "query": [
                {
                  "description": "PENDING, CONFIRMED, CANCELLED o COMPLETED",
                  "key": "status",
                  "value": "PENDING"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "skip",
                  "value": "0"
                }
              ],
              "raw": "{{baseUrl}}/booking/mine?status=PENDING&limit=10&skip=0"
            }
          },
          "response": []
        },
        {
          "id": "booking-confirm",
          "name": "Confirmar reserva (tutor dueño)",
          "request": {
            "description": "Solo el tutor dueño (hagan login como tutor antes). Pasa PENDING → CONFIRMED.",
            "method": "PATCH",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                ":id",
                "confirm"
              ],
              "raw": "{{baseUrl}}/booking/:id/confirm",
              "variable": [
                {
                  "description": "UUID de la reserva",
                  "key": "id",
                  "value": "{{bookingId}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "id": "booking-cancel",
          "name": "Cancelar reserva (dueño)",
          "request": {
            "description": "El dueño de la reserva (estudiante o tutor). Pasa PENDING/CONFIRMED → CANCELLED.",
            "method": "PATCH",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                ":id",
                "cancel"
              ],
              "raw": "{{baseUrl}}/booking/:id/cancel",
              "variable": [
                {
                  "description": "UUID de la reserva",
                  "key": "id",
                  "value": "{{bookingId}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "id": "booking-complete",
          "name": "Completar reserva (tutor dueño)",
          "request": {
            "description": "Solo el tutor dueño. Pasa CONFIRMED → COMPLETED (luego se podrá reseñar).",
            "method": "PATCH",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                ":id",
                "complete"
              ],
              "raw": "{{baseUrl}}/booking/:id/complete",
              "variable": [
                {
                  "description": "UUID de la reserva",
                  "key": "id",
                  "value": "{{bookingId}}"
                }
              ]
            }
          },
          "response": []
        }
      ],
      "name": "Booking"
    },
    {
      "description": "Una reseña por reserva COMPLETED, solo del estudiante dueño. Antes: completar la reserva como tutor y volver a iniciar sesión como ese estudiante. Usa {{bookingId}} y {{tutorProfileId}}.",
      "item": [
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('respuesta esperada', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "  pm.collectionVariables.set('reviewId', res.id);",
                  "  console.log('Reseña guardada en {{reviewId}}: ' + res.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "id": "review-create",
          "name": "Crear reseña (student dueño)",
          "request": {
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"rating\": 5,\n  \"comment\": \"Explica muy claro y es puntual.\"\n}"
            },
            "description": "Solo el estudiante dueño de una reserva COMPLETED (inicien sesión con ese usuario). rating va de 1 a 5 y comment de 3 a 500 caracteres. Si la reserva no está COMPLETED responde 400; si no es suya, 403; si no existe, 404; si ya tiene reseña, 409. El script guarda el id en {{reviewId}}.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "review"
              ],
              "raw": "{{baseUrl}}/review"
            }
          },
          "response": []
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('respuesta esperada', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const res = pm.response.json();",
                  "  pm.expect(res).to.have.property('average');",
                  "  pm.expect(res).to.have.property('count');",
                  "  pm.expect(res).to.have.property('reviews');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "id": "review-by-tutor",
          "name": "Listar reseñas de un tutor",
          "request": {
            "description": "Cualquier sesión. tutorId es el UUID del perfil ({{tutorProfileId}}), no el del usuario. Devuelve average, count y reviews.",
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "review",
                "tutor",
                ":tutorId"
              ],
              "raw": "{{baseUrl}}/review/tutor/:tutorId",
              "variable": [
                {
                  "description": "UUID del perfil de tutor",
                  "key": "tutorId",
                  "value": "{{tutorProfileId}}"
                }
              ]
            }
          },
          "response": []
        }
      ],
      "name": "Review"
    },
    {
      "description": "Carga datos iniciales (admin, materias, tutores, estudiantes). Borra review, booking, tutor_profile, subject y user en ese orden.",
      "item": [
        {
          "id": "seed-run",
          "name": "Ejecutar seed",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "description": "Borra y recarga todo. `key` debe coincidir con `SEED_KEY` del `.env` (si no, `401`). Úsenlo solo en su base local.",
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "seed"
              ],
              "query": [
                {
                  "description": "Debe coincidir con SEED_KEY del .env",
                  "key": "key",
                  "value": "{{seedKey}}"
                }
              ],
              "raw": "{{baseUrl}}/seed?key={{seedKey}}"
            }
          },
          "response": []
        }
      ],
      "name": "Seed"
    }
