      "description": "Estados: PENDING, CONFIRMED, CANCELLED, COMPLETED",
      "item": [
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "  pm.collectionVariables.set('bookingId', res.id);",
                  "  console.log('Reserva guardada en {{bookingId}}: ' + res.id);",
