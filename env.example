# Copia este archivo a .env y ajusta los valores. .env NO se sube al repo.

# --- Base de datos (PostgreSQL) ---
# En local (npm run start:dev) usa localhost.
# Con docker compose, el servicio "api" lo sobrescribe a "db".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tutorlink
DB_USERNAME=postgres
DB_PASSWORD=cambia_esta_clave

# --- JWT ---
# Evita el caracter $ en secretos: docker compose lo interpreta como variable.
JWT_SECRET=cambia_este_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1h

# --- 2FA (nombre que aparece en Google Authenticator) ---
TWO_FA_ISSUER=TutorLink

# --- Seed (usuario administrador inicial) ---
ADMIN_EMAIL=admin@tutorlink.com
ADMIN_PASSWORD=Admin12345
ADMIN_FULL_NAME=Administrador TutorLink
SEED_KEY=cambia_esta_llave_del_seed
